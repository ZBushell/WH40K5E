        <profile name="Energy Field" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="dbf1-b0a2-0b87-ac02">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any ranged attack against the Wave Serpent from the front or side arc with a Strength of greater than 8 counts as S8. In addition, all ranged attacks never roll more than +1D6 for their armour penetration (for example, melta weapons at half range or ordnance only roll one dice). Attacks in close combat, or from the read, are unaffected by the energy field rule.</characteristic>
          </characteristics>
        </profile>
