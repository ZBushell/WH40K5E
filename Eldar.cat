  <sharedRules>
    <rule name="Warlock Power" id="6622-8fbf-6aa8-2e1e" hidden="false">
      <description>Warlock powers are available permanently, so he does not need to take a Psychic test to use it.</description>
    </rule>
    <rule name="Farseer Psychic Powers" id="50c7-0050-7401-e053" hidden="false">
      <description>Farseer Powers are used at the start of the Eldar turn and do not require the Eldar Psyker to have line of sight to the target.</description>
    </rule>
    <rule name="Compulsory unit: Wraithguard" id="14c4-7788-65ce-1dd0" hidden="false" publicationId="iaa2-2011-eldar" page="59">
      <description>This force must include at least one unit of Wraithguard to include a Wraithseer.</description>
    </rule>
    <rule name="Compulsory HQ: non-Wraithseer" id="8245-ee4d-c402-985f" hidden="false" publicationId="iaa2-2011-eldar" page="59">
      <description>A Wraithseer cannot fulfil a mandatory HQ slot. Always include another non-Wraithseer HQ selection in the army.</description>
    </rule>
    <rule name="Super-Heavy Flyer" id="77d2-76a2-a1b0-ee2e" hidden="false" publicationId="iaa2-2011-eldar" page="63">
      <description>Unit type: Super-heavy Flyer. Use the Apocalypse Flyer rules in addition to the Super-heavy Vehicle rules.</description>
    </rule>
  </sharedRules>
