    <profile name="Phantom D-Cannon" id="bc7b-22f3-f28f-955e" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="60">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">72"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">D</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Ordnance 1, 10" Blast, Barrage, Primary Weapon, D-Cannon</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Bypasses power fields and void shields. Each hit inflicts D3 rolls on the Super-heavy Damage chart.</characteristic>
      </characteristics>
    </profile>
    <profile name="Phantom Starcannon" id="f5ac-82e7-5375-80aa" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="60">
