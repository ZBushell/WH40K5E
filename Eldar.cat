    </profile>
    <profile name="Shuriker Cannon" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="db20-c0b9-7553-8719">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">24&quot;</characteristic>
