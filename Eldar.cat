      </characteristics>
    </profile>
    <profile name="Phantom Pulse Laser" id="e4cf-576e-0be0-cc6c" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="60">
