        <characteristic name="Structure Points" typeId="0a2a-2e66-c248-4b50">3</characteristic>
      </characteristics>
    </profile>
    <profile name="Transport Restrictions" id="3d6d-77cf-975f-6027" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="63">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The Vampire Raider cannot carry an Avatar, Wraithlord, or any other vehicles.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vampire Hunter" id="f0b4-502d-c389-32d5" typeId="4f6f-b40f-36fb-7ece" typeName="Super-Heavy Vehicle" hidden="false" publicationId="iaa2-2011-eldar" page="64">
