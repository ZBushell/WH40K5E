      </characteristics>
    </profile>
    <profile name="Aerial Assault" id="14ff-7430-1f4b-ef23" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="62">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The vehicle may fire all of its weapons when moving at cruising speed.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vampire Raider" id="55ed-3ef4-5098-3c56" typeId="4f6f-b40f-36fb-7ece" typeName="Super-Heavy Vehicle" hidden="false" publicationId="iaa2-2011-eldar" page="63">
      <characteristics>
