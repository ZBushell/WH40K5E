      </characteristics>
    </profile>
    <profile name="Lynx" id="d3d6-73ac-dc94-8faa" typeId="4f6f-b40f-36fb-7ece" typeName="Super-Heavy Vehicle" hidden="false" publicationId="iaa2-2011-eldar" page="65">
      <characteristics>
