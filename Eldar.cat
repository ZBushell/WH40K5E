        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 4, Anti-aircraft Mount</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
      </characteristics>
    </profile>
    <profile name="Titan Close Combat Weapon" id="03ca-a418-f55d-f48a" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="60">
      <characteristics>
        <characteristic name="Ability" typeId="2113-98a2-4376-a94c">Adds +3 Attacks and includes twin-linked Phantom Starcannons. Only one may be taken.</characteristic>
      </characteristics>
    </profile>
    <profile name="Enhanced Eldar Titan Holo-fields" id="3fce-320d-8f1f-8b90" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="60">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The Titan has a 4+ invulnerable save, improved to 3+ if it moved this turn or the previous turn. Close combat attacks require a 6 to hit, except those made by other Super-heavy Walkers or Gargantuan Creatures.</characteristic>
      </characteristics>
    </profile>
    <profile name="Agile" id="8cb7-27b0-d98d-de49" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="60">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">In the Shooting phase, either fire all weapons normally; fire one primary weapon and move an extra 2D6"; or fire no primary weapons and move an extra 3D6".</characteristic>
      </characteristics>
    </profile>
    <profile name="Towering Monstrosity" id="dd69-1fd5-c792-21db" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="60">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Shoulder-mounted weapons cannot target enemy units within 12" of the Phantom Titan.</characteristic>
      </characteristics>
    </profile>
    <profile name="Spirit Guides" id="8c31-fb07-a408-8ef4" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="60">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Ignore Driver Stunned or Gun Crew Shaken results on a D6 roll of 3+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hornet" id="a8b9-ffb2-0b9b-5a9e" typeId="0092-3322-1b28-b657" typeName="Vehicle" hidden="false" publicationId="iaa2-2011-eldar" page="62">
