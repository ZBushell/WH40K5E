        <characteristic name="R" typeId="5972-c096-9c99-ea47">10</characteristic>
        <characteristic name="Structure Points" typeId="0a2a-2e66-c248-4b50">2</characteristic>
      </characteristics>
    </profile>
    <profile name="Sonic Lance" id="f256-10fd-4c11-2314" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="65">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">Hellstorm</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">X</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 1, Primary Weapon, Pinning</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Place the narrow end of the Hellstorm template within 18" of the weapon; the wide end must be no closer to it. Determine hits as for a template weapon. Wounds on 3+ regardless of Toughness; rolls 3D6 for armour penetration.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sky-Hunter" id="fb91-6ea3-9dd5-41f3" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="65">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the beginning of the Eldar turn, the Lynx may become a Flyer until the beginning of its next turn. It cannot fire its weapons during a turn in which it flew.</characteristic>
      </characteristics>
    </profile>
    <profile name="Targeting Matrix Override" id="537c-512f-253b-d5bb" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="65">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The primary weapon save against Gun Crew Shaken or Weapon Destroyed results is improved to 3+ from the usual 4+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warp Hunter" id="d2ab-5e5a-a33a-e976" typeId="0092-3322-1b28-b657" typeName="Vehicle" hidden="false" publicationId="iaa2-2011-eldar" page="66">
      <characteristics>
        <characteristic name="BS" typeId="b539-c71b-9239-8da0">4</characteristic>
        <characteristic name="F" typeId="84f1-6495-b3c8-6025">12</characteristic>
        <characteristic name="S" typeId="38b6-8429-f0fd-11cb">12</characteristic>
        <characteristic name="R" typeId="10a0-8c50-f9d5-466b">10</characteristic>
      </characteristics>
    </profile>
    <profile name="Distortion Cannon (Blast)" id="f3e2-a0b9-a293-cf36" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="66">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">36"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">X</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 1, 5" Blast, Barrage, D-Cannon</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Bypasses power fields and void shields. Wounds models with Toughness on 2+ and inflicts Instant Death on a wound roll of 6. Against armour, roll a D6: 2-4 inflicts a glancing hit; 5+ a penetrating hit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Distortion Cannon (Aether Rift)" id="73c4-62f4-1d70-0664" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="66">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">Template</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">X</characteristic>
        <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">2</characteristic>
        <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Heavy 1, D-Cannon</characteristic>
        <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c">Bypasses power fields and void shields. Wounds models with Toughness on 2+ and inflicts Instant Death on a wound roll of 6. Against armour, roll a D6: 2-4 inflicts a glancing hit; 5+ a penetrating hit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Aether Rift" id="ffb1-ed6c-0970-0eab" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="66">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Instead of the Blast profile, use the Aether Rift template profile. Place the narrow end within 6" of the weapon, with the large end no closer to the weapon. Resolve hits as for a template weapon, using the D-Cannon special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Strike Force" id="ecee-61ef-a91a-07f1" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="67">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Deploy every unit within 12" of the command Wave Serpent. When entering from reserve, enter within 12" of the point where the command vehicle entered.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shadowfire" id="c005-df1c-ea38-ca76" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="67">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">While the command vehicle remains mobile, the whole formation has Night Vision/Acute Senses and may re-roll failed Target Priority tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Strategic Redeployment" id="71d5-71ff-e666-138c" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="67">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The formation receives one Strategic Redeployment strategic asset.</characteristic>
      </characteristics>
    </profile>
    <profile name="Formation Composition" id="861b-719d-36c6-9648" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="67">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Three or more Guardian squads, each mounted in a Wave Serpent; 0-2 Fire Storms; 0-3 Night Spinners. Designate the Wave Serpent of the Command Squad as the command vehicle. All embarked models must fit their transports.</characteristic>
      </characteristics>
    </profile>
    <profile name="Source gap: Night Spinner details omitted" id="706c-c6d2-fd51-e1da" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="67">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">The source permits 0-3 Night Spinners, but gives no unit datasheet, points, or equipment here. These missing specifics are flagged and omitted; no substitute rules or selectable placeholder are included.</characteristic>
      </characteristics>
    </profile>
    <profile name="Strike Force" id="c3ae-8dee-8f5f-cb7f" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="68">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">All squads in the formation must begin the game embarked in its Vampire Raider. The Vampire Raider begins in Strategic Reserve. Check its 30-model capacity, reduced to 20 with either main-weapon replacement, against all embarked models.</characteristic>
      </characteristics>
    </profile>
    <profile name="At Kaela Mensha Khaine's Bidding" id="ee62-193b-7409-dff7" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" publicationId="iaa2-2011-eldar" page="68">
      <characteristics>
        <characteristic name="Description" typeId="e24a-6018-20cf-d76c">All units in the formation ignore negative Leadership modifiers and use their standard, unmodified Leadership for every test.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
