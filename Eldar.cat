      </characteristics>
    </profile>
    <profile name="Twin-linked Firestorm Scatter Lasers with Anti-Aircraft Mount" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="18d1-62d0-93fb-ec6a" publicationId="iaa2-2011-eldar" page="58">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">60"</characteristic>
