    <selectionEntry type="unit" import="true" name="Prince Yriel of Iyanden" hidden="false" id="fd06-d26f-01b0-0dcc">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="155"/>
      </costs>
      <infoLinks>
        <infoLink name="Forceshield" id="85cf-c606-a94f-1895" hidden="false" type="profile" targetId="d22a-e1bb-dbd6-b516"/>
        <infoLink name="Yriel" id="406c-2474-41ed-7691" hidden="false" type="profile" targetId="19e7-3d25-eccf-297d"/>
        <infoLink name="Plasma Grenades" id="3335-f80b-1314-5df5" hidden="false" type="profile" targetId="f199-6b5f-7b3d-f011"/>
        <infoLink name="Independent Character" id="9585-49b1-4c80-e631" hidden="false" type="profile" targetId="db9c-91d8-5b8a-ee16"/>
        <infoLink name="Master Strategist" id="1bfd-dd99-96f3-5fa6" hidden="false" type="profile" targetId="e419-7f8e-7b40-28e4"/>
        <infoLink name="Fleet" id="bc22-84ab-fe56-756d" hidden="false" type="profile" targetId="3748-79f1-e937-8650"/>
      </infoLinks>
      <profiles>
        <profile name="Doomed" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="3ee8-08bb-b12e-b785">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the end of every game, Yriel suffers one automatic wound from his own weapon. Yriel may take his forceshield save as normal.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spear of Twilight" typeId="1d88-1369-f0ed-b39c" typeName="Melee Weapons" hidden="false" id="37b2-199b-4250-11d5">
          <characteristics>
            <characteristic name="Ability" typeId="2113-98a2-4376-a94c">This weapon is a singing spear that ignores armour saves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Eye of Wrath" typeId="456a-26d9-cb27-bd5c" typeName="Wargear" hidden="false" id="84fd-711f-46a9-9da5">
          <characteristics>
            <characteristic name="Description" typeId="9e5e-2cfd-7c93-749a">Once per game, Yriel can activate the Eye of Wrath in lieu of making his normal attack in assault. Place the large blast template with the hole centred over Yriel; all models under the template take a Strength 6 hit at AP 3. Yriel is not affected.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
