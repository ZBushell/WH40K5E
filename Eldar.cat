    <selectionEntry type="unit" import="true" name="Avatar of Khaine" hidden="false" id="7145-e874-4b23-3180">
      <costs>
        <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="155"/>
      </costs>
      <profiles>
        <profile name="Inspiring" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="9764-6eb9-c8c8-e1ec">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any Eldar unit with a model within 12&quot; of the Avatar becomes Fearless.</characteristic>
          </characteristics>
        </profile>
        <profile name="Molten Body" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="5a63-51f3-dfc8-800f">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Melta weapons, flamers and heavy flamers cannot wound the Avatar.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Wailing Doom" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" id="0223-f9fd-e661-a358">
          <characteristics>
            <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12&quot;</characteristic>
            <characteristic name="Str." typeId="1ebc-896c-43de-904a">8</characteristic>
            <characteristic name="AP" typeId="730c-47dc-fdad-3c8b">1</characteristic>
            <characteristic name="Type" typeId="1524-30c8-5da7-66ff">Assault 1, Melta</characteristic>
            <characteristic name="Notes" typeId="45fd-0f50-e1d0-907c"/>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink targetId="6b1b-944b-162c-6851" id="d3c9-3b35-2900-40b2" type="rule" name="Monstrous Creature" hidden="false"/>
