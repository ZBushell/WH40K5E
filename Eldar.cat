    <profile name="Phantom AA Launcher" id="9a55-6b08-c1a8-2f4a" typeId="8e6f-7553-28c5-95a0" typeName="Weapons" hidden="false" publicationId="iaa2-2011-eldar" page="60">
      <characteristics>
        <characteristic name="Range" typeId="9b9e-0c24-e409-a801">12"-48"</characteristic>
        <characteristic name="Str." typeId="1ebc-896c-43de-904a">7</characteristic>
